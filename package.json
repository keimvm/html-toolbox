{
  "name": "toolbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^24.21.0 || ^26.9.0",
    "pnpm": "12.4.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:dist": "vitest run --project dist",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build && pnpm test:dist && git diff --check"
  },
  "dependencies": {
    "@embedpdf/engines": "2.15.0",
    "@embedpdf/fonts-jp": "1.0.0",
    "@embedpdf/models": "2.15.0",
    "@embedpdf/pdfium": "2.15.0",
    "@preact/signals": "2.11.3",
    "diff": "9.0.0",
    "markdown-it": "14.2.0",
    "preact": "10.29.8",
    "prosemirror-commands": "1.7.2",
    "prosemirror-dropcursor": "1.8.3",
    "prosemirror-gapcursor": "1.4.1",
    "prosemirror-history": "1.5.0",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.7",
    "prosemirror-model": "1.25.11",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "1.42.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.1"
  }
}
