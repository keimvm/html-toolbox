{
  "name": "pdf-edit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^24.21.0 || ^26.9.0",
    "pnpm": "12.4.2"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude tests/build.test.ts",
    "test:dist": "vitest run tests/build.test.ts",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build && pnpm test:dist && git diff --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/cli": "0.1.21",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "fake-indexeddb": "6.2.4",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@embedpdf/engines": "2.15.0",
    "@embedpdf/fonts-jp": "1.0.0",
    "@embedpdf/models": "2.15.0",
    "@embedpdf/pdfium": "2.15.0"
  }
}
